{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://heimgewebe.local/chronik/knowledge-event-v1.schema.json",
  "title": "Chronik semantic knowledge event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "record_key",
    "kind",
    "ts",
    "source",
    "subject",
    "knowledge_type",
    "epistemic_status",
    "statement",
    "evidence_refs",
    "relations"
  ],
  "properties": {
    "schema_version": {
      "const": "chronik-knowledge-event.v1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "record_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,159}$"
    },
    "kind": {
      "const": "knowledge.insight.published.v1"
    },
    "ts": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "component"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,159}$"
        },
        "component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,159}$"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "knowledge_type": {
      "enum": [
        "decision",
        "root_cause",
        "repair",
        "refutation",
        "open_problem",
        "requirement",
        "operation",
        "observation"
      ]
    },
    "epistemic_status": {
      "enum": [
        "observed",
        "hypothesis",
        "confirmed",
        "refuted",
        "decided",
        "implemented",
        "production_verified",
        "superseded"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 900
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:/._@#-]{0,239}$"
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "event_id"
        ],
        "properties": {
          "type": {
            "enum": [
              "supersedes",
              "refutes",
              "confirms",
              "amends"
            ]
          },
          "event_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
