[Unit]
Description=chronik local event store
Documentation=https://github.com/heimgewebe/chronik
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=CHRONIK_ROOT=%h/repos/chronik
Environment=CHRONIK_PORT=8788
Environment=CHRONIK_HOST=127.0.0.1
Environment=CHRONIK_DATA_DIR=%h/.local/state/chronik/data
Environment=CHRONIK_LOG_LEVEL=INFO
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-%h/.config/chronik/chronik.env
ExecStart=/bin/bash -lc 'cd "$CHRONIK_ROOT" && exec bash scripts/run-chronik-service.sh'
Restart=on-failure
RestartSec=5s
UMask=0077

[Install]
WantedBy=default.target
